{
  "name": "library-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "dev:web": "npm run dev -w @library/web",
    "lint": "npm run lint -w @library/web",
    "lint:fix": "npm run lint:fix -w @library/web",
    "format": "npm run format -w @library/web",
    "format:check": "npm run format:check -w @library/web",
    "build": "npm run build -w @library/web && cd apps/api && ./mvnw -DskipTests package",
    "typecheck": "npm run typecheck -w @library/web",
    "test": "bash scripts/test.sh",
    "db:start": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "admin:create": "bash scripts/create-admin.sh",
    "db:seed": "bash scripts/seed.sh",
    "db:migrate": "bash scripts/migrate.sh",
    "catalog:crawl": "python3 scripts/crawl-fanqie.py --limit 1000",
    "catalog:import": "bash scripts/import-catalog.sh",
    "catalog:covers": "bash scripts/crawl-covers.sh",
    "catalog:prepare": "bash scripts/maintain-catalog.sh prepare",
    "catalog:covers:import": "bash scripts/maintain-catalog.sh covers",
    "catalog:copies:distribute": "bash scripts/maintain-catalog.sh distribute"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
