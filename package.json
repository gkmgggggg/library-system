{
  "name": "library-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "dev:web": "npm run dev -w @library/web",
    "build": "npm run build -w @library/web && cd apps/api && ./mvnw -DskipTests package",
    "typecheck": "npm run typecheck -w @library/web",
    "test": "bash scripts/test.sh",
    "db:start": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "admin:create": "bash scripts/create-admin.sh",
    "db:seed": "bash scripts/seed.sh",
    "db:migrate": "bash scripts/migrate.sh"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
